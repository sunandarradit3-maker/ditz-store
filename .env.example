# ==============================
# DiTz Store environment template
# ==============================
# Copy this file to .env on VPS. NEVER commit the real .env file.

# Supabase server database (required for real checkout, accounts, orders, admin data)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional public Supabase values. Only needed if client-side Supabase is added later.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Session signing secret (required). Generate a long random value, 32+ bytes.
SESSION_SECRET=replace-with-a-long-random-secret

# Admin credentials (required for /admin). SERVER-ONLY: never prefix with NEXT_PUBLIC_.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-temporary-demo-password

# Store profile
NEXT_PUBLIC_WHATSAPP_NUMBER=6280000000000
NEXT_PUBLIC_STORE_NAME=DiTz Store
