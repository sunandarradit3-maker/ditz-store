# Supabase server database
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Public Supabase values (optional, only if using client-side Supabase later)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Session signing. Use a long random value (32+ bytes)
SESSION_SECRET=replace-with-a-long-random-secret

# Admin credentials are SERVER-ONLY. Never prefix these with NEXT_PUBLIC_
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Store profile
NEXT_PUBLIC_WHATSAPP_NUMBER=6280000000000
NEXT_PUBLIC_STORE_NAME=DiTz Store
